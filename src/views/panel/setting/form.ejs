<div class="card">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="settingsTabs" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-general">General</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-pricing">Pricing</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-inventory">Inventory</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-email">Email</a></li>
        </ul>
    </div>

    <!-- General/Inventory/Email share one Settings document/form. Pricing is
         deliberately NOT inside this form: Bulk Price Adjustment below needs
         its own <form>/action (it's a one-off bulk operation on Products, not
         a Settings field), and a <form> can never nest inside another. -->
    <form action="/panel/settings" method="POST" enctype="multipart/form-data">
        <div class="card-body">
            <div class="tab-content">

                <!-- General -->
                <div class="tab-pane fade show active" id="tab-general">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Company Name</label>
                            <input type="text" name="companyName" class="form-control" value="<%= record.general?.companyName || '' %>" maxlength="150">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Timezone</label>
                            <input type="text" name="timezone" class="form-control" value="<%= record.general?.timezone || '' %>" placeholder="Asia/Kolkata">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Currency</label>
                            <select name="currency" class="form-select">
                                <% ['INR','USD','EUR','GBP'].forEach(function (c) { %>
                                    <option value="<%= c %>" <%= (record.general?.currency || 'INR') === c ? 'selected' : '' %>><%= c %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="contactEmail" class="form-control" value="<%= record.contactDetails?.email || '' %>">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Phone Code</label>
                            <input type="text" name="contactPhoneCode" class="form-control" value="<%= record.contactDetails?.phoneCode || '' %>" maxlength="5">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" name="contactPhone" class="form-control" value="<%= record.contactDetails?.phone || '' %>" maxlength="20">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="address" class="form-control" rows="2"><%= record.contactDetails?.location?.address1 || '' %></textarea>
                    </div>

                    <hr>
                    <h5>Logo</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Logo</label>
                            <small class="form-hint d-block mb-2">Shown wherever the full wordmark logo is used. SVG or PNG with a transparent background works best.</small>
                            <% if (logoFullUrl) { %>
                                <div class="mb-2 p-3 rounded" style="background:#241c14;display:inline-block;">
                                    <img src="<%= logoFullUrl %>" style="height:60px;width:auto;" onerror="this.style.visibility='hidden'">
                                </div>
                            <% } %>
                            <input type="file" name="logoFull" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Folded Mark</label>
                            <small class="form-hint d-block mb-2">Shown in the sidebar while it's folded/collapsed to its narrow, icon-only width.</small>
                            <% if (logoMarkUrl) { %>
                                <div class="mb-2 p-3 rounded" style="background:#241c14;display:inline-block;">
                                    <img src="<%= logoMarkUrl %>" style="height:60px;width:auto;" onerror="this.style.visibility='hidden'">
                                </div>
                            <% } %>
                            <input type="file" name="logoMark" class="form-control" accept="image/*">
                        </div>
                    </div>
                </div>

                <!-- Inventory -->
                <div class="tab-pane fade" id="tab-inventory">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Default Low Stock Threshold</label>
                            <input type="number" min="0" name="defaultLowStockThreshold" class="form-control" value="<%= record.inventory?.defaultLowStockThreshold ?? 5 %>">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Inventory Adjustment Rules</label>
                        <textarea name="inventoryAdjustmentRules" class="form-control" rows="3" placeholder="e.g. Stock adjustments over 100 units require Account Manager approval."><%= record.inventory?.inventoryAdjustmentRules || '' %></textarea>
                    </div>
                </div>

                <!-- Email -->
                <div class="tab-pane fade" id="tab-email">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SMTP Host</label>
                            <input type="text" name="smtpHost" class="form-control" value="<%= record.email?.smtpHost || '' %>">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" name="smtpPort" class="form-control" value="<%= record.email?.smtpPort ?? '' %>">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">SMTP Username</label>
                            <input type="text" name="smtpUsername" class="form-control" value="<%= record.email?.smtpUsername || '' %>">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">From Email</label>
                            <input type="email" name="fromEmail" class="form-control" value="<%= record.email?.fromEmail || '' %>">
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="card-footer" id="settingsSaveFooter">
            <button type="submit" class="btn btn-primary">Save Settings</button>
        </div>
    </form>

    <!-- Pricing tab-pane: outside the Settings form above (see comment there).
         Hidden by default; shown/hidden by the tab script below like every
         other pane, just driven manually since it isn't a sibling inside the
         same .tab-content the other three panes share. -->
    <div class="tab-pane" id="tab-pricing" hidden>
        <div class="card-body">
            <h3 class="card-title mb-3">Bulk Price Adjustment</h3>
            <div class="alert alert-warning mb-3">
                Raises or lowers the current price of every product in the selected category by a flat percentage - applied immediately to all matching products, with no way to undo besides running the reverse adjustment.
            </div>
            <form action="/panel/settings/bulk-price-adjustment" method="POST">
                <div class="row align-items-end">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Category <span class="required-mark">*</span></label>
                        <select name="categoryId" class="form-select" required>
                            <option value="">Select category</option>
                            <% categories.forEach(function (c) { %>
                                <option value="<%= c._id %>"><%= c.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Adjustment <span class="required-mark">*</span></label>
                        <select name="direction" class="form-select" required>
                            <option value="INCREASE">Increase price by</option>
                            <option value="DECREASE">Decrease price by</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Percentage <span class="required-mark">*</span></label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0.01" max="100" name="percentage" class="form-control" required placeholder="10">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-2 mb-3">
                        <button type="submit" class="btn btn-warning w-100" onclick="return confirm('This will change the price of every product in the selected category right away. Continue?');">Apply</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Pane visibility is fully self-managed here rather than left to Bootstrap's
    // Tab plugin, since #tab-pricing intentionally isn't a sibling inside the
    // same .tab-content as the other three panes (see comments above) and
    // Bootstrap's own "hide the previously active pane" lookup isn't guaranteed
    // to find it there. The nav <a> tags' own active-state switching (they're
    // all still inside one <ul class="nav-tabs">) is left to Bootstrap as normal.
    var TAB_PANE_IDS = ['tab-general', 'tab-pricing', 'tab-inventory', 'tab-email'];

    function syncActiveTab(activeId) {
        TAB_PANE_IDS.forEach(function (id) {
            var pane = document.getElementById(id);
            var isActive = id === activeId;
            pane.hidden = !isActive;
            pane.classList.toggle('show', isActive);
            pane.classList.toggle('active', isActive);
        });
        // Save Settings only ever applies to General/Inventory/Email - hide it
        // while on Pricing, which has nothing of its own left to save.
        document.getElementById('settingsSaveFooter').hidden = activeId === 'tab-pricing';
    }

    document.querySelectorAll('#settingsTabs a[data-bs-toggle="tab"]').forEach(function (tabLink) {
        tabLink.addEventListener('shown.bs.tab', function (e) {
            syncActiveTab(e.target.getAttribute('href').slice(1));
        });
    });

    syncActiveTab('tab-general');
</script>
