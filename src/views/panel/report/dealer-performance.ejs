<div class="card">
    <div class="card-header">
        <h3 class="card-title">Dealer Performance Report</h3>
        <div class="card-tools">
            <a href="/panel/reports" class="btn btn-sm btn-default">Back to Reports</a>
            <% if (can('REPORT.EXPORT')) { %>
                <a href="/panel/reports/dealer-performance/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-sm btn-primary"><i class="fas fa-file-export"></i> Export</a>
            <% } %>
        </div>
    </div>

    <div class="card-body border-bottom">
        <form method="GET" action="/panel/reports/dealer-performance" class="row align-items-end">
            <div class="col-md-3 mb-3">
                <label class="form-label mb-1">From</label>
                <input type="date" name="dateFrom" value="<%= filters.dateFrom || '' %>" class="form-control">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label mb-1">To</label>
                <input type="date" name="dateTo" value="<%= filters.dateTo || '' %>" class="form-control">
            </div>
            <div class="col-md-2 mb-3">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-vcenter table-sm mb-0 card-table">
                <thead>
                    <tr>
                        <th>Dealer</th><th>Orders</th><th>Total Quantity</th><th>Total Purchase Value</th><th>Average Order Value</th><th>Last Order</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!rows.length) { %>
                        <tr><td colspan="6" class="text-center text-muted py-4">No dealer activity in this range</td></tr>
                    <% } %>
                    <% rows.forEach(function (r) { %>
                        <tr>
                            <td><%= r.dealerName %></td>
                            <td><%= r.orderCount %></td>
                            <td><%= r.totalQuantity %></td>
                            <td><%= r.totalPurchaseValue.toFixed(2) %></td>
                            <td><%= r.averageOrderValue.toFixed(2) %></td>
                            <td><%= r.lastOrderDate ? new Date(r.lastOrderDate).toLocaleDateString() : '-' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
