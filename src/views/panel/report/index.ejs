<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title">Sales Report</h3>
                <p class="text-muted">Every purchase order item that has moved past review, with dealer, quantity, pricing, and totals.</p>
                <a href="/panel/reports/sales" class="btn btn-primary btn-sm">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title">Dealer Performance</h3>
                <p class="text-muted">Orders, quantity, and total purchase value per dealer.</p>
                <a href="/panel/reports/dealer-performance" class="btn btn-primary btn-sm">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title">Product Performance</h3>
                <p class="text-muted">Units sold and revenue per product, based on order history.</p>
                <a href="/panel/reports/product-performance" class="btn btn-primary btn-sm">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title">Inventory / Low Stock</h3>
                <p class="text-muted">Current stock levels against the low-stock threshold for every product.</p>
                <a href="/panel/reports/inventory" class="btn btn-primary btn-sm">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title">Monthly Report</h3>
                <p class="text-muted">Trailing 12 months of orders, sales, units sold, and dealer growth.</p>
                <a href="/panel/reports/monthly" class="btn btn-primary btn-sm">Open</a>
            </div>
        </div>
    </div>
