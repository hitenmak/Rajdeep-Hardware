<div class="card">
    <div class="card-header">
        <h3 class="card-title">Attributes</h3>
        <div class="card-tools">
            <% if (can('ATTRIBUTE.CREATE')) { %>
                <a href="/panel/attributes/create" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Add Attribute</a>
            <% } %>
        </div>
    </div>

    <div class="card-body border-bottom">
        <form method="GET" action="/panel/attributes" class="row align-items-end">
            <div class="col-md-4 mb-3">
                <label class="form-label mb-1">Search</label>
                <input type="text" name="search" value="<%= filters.search || '' %>" class="form-control" placeholder="Attribute name">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label mb-1">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="INACTIVE" <%= filters.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                </select>
            </div>
            <div class="col-md-2 mb-3">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-vcenter table-striped mb-0 card-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Input Type</th>
                        <th>Values</th>
                        <th>Variation Attribute</th>
                        <th>Status</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!records || !records.length) { %>
                        <tr><td colspan="7" class="text-center text-muted py-4">No attributes found</td></tr>
                    <% } %>
                    <% records.forEach(function (r) { %>
                        <tr>
                            <td><%= r.name %></td>
                            <td><code><%= r.code %></code></td>
                            <td><%= r.inputType %></td>
                            <td><span class="badge badge-info"><%= countMap[r._id] || 0 %></span></td>
                            <td><%= r.isVariationAttribute ? 'Yes' : 'No' %></td>
                            <td><span class="badge <%= r.status === 'ACTIVE' ? 'badge-success' : 'badge-secondary' %>"><%= r.status %></span></td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/panel/attributes/<%= r._id %>/edit" class="btn btn-xs btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                    <% if (can('ATTRIBUTE.DELETE')) { %>
                                        <form action="/panel/attributes/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this attribute and all its values?');">
                                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <%- include('../partials/pagination') %>
    </div>
</div>
