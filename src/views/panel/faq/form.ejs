<div class="row">
    <div class="col-md-9">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><%= record ? 'Edit FAQ' : 'Add FAQ' %></h3>
            </div>
            <form action="<%= record ? '/panel/faqs/' + record._id + '/edit' : '/panel/faqs/create' %>" method="POST">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Question <span class="required-mark">*</span></label>
                        <input type="text" name="question" class="form-control" value="<%= record ? record.question : '' %>" required maxlength="300">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Answer <span class="required-mark">*</span></label>
                        <textarea name="answer" class="form-control" rows="6" required maxlength="5000"><%= record ? record.answer : '' %></textarea>
                        <small class="form-hint">Plain text. Line breaks are kept in the dealer app.</small>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Sort Order</label>
                            <input type="number" name="sortOrder" class="form-control" value="<%= record ? (record.sortOrder || 0) : 0 %>">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Status <span class="required-mark">*</span></label>
                            <select name="status" class="form-select" required>
                                <% ['ACTIVE', 'INACTIVE'].forEach(function (s) { %>
                                    <option value="<%= s %>" <%= (record ? record.status : 'ACTIVE') === s ? 'selected' : '' %>><%= s %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save FAQ</button>
                    <a href="/panel/faqs" class="btn btn-default">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
