<div class="text-center mb-4">
    <img src="/resource/img/RD.png" alt="Rajdeep Hardware" class="auth-logo">
</div>

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Enter your email to receive a reset OTP</h2>

        <form action="/panel/forgot-password" method="POST">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group input-group-flat">
                    <input type="email" name="email" class="form-control" placeholder="Email" required autofocus>
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                </div>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Send OTP</button>
            </div>
        </form>

        <div class="text-center text-secondary mt-3">
            <a href="/panel/login">Back to login</a>
        </div>
    </div>
</div>
