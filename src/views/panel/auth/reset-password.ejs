<div class="text-center mb-4">
    <img src="/resource/img/RD.png" alt="Rajdeep Hardware" class="auth-logo">
</div>

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Set a new password for your account</h2>

        <form action="/panel/forgot-password/reset" method="POST">
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <div class="input-group input-group-flat">
                    <input type="password" name="password" class="form-control" placeholder="New password" required autofocus minlength="6" maxlength="20">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <div class="input-group input-group-flat">
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm password" required minlength="6" maxlength="20">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                </div>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </div>
        </form>
    </div>
</div>
