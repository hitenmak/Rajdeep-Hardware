<div class="row">
    <div class="col-md-8">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">User Details</h3>
                <div class="card-tools">
                    <% if (can('USER.UPDATE')) { %>
                        <a href="/panel/users/<%= record._id %>/edit" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i> Edit</a>
                    <% } %>
                    <a href="/panel/users" class="btn btn-sm btn-default">Back</a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8"><%= record.firstName %> <%= record.lastName %></dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><%= record.email %></dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8"><%= record.phoneCode || '' %> <%= record.phone || '-' %></dd>

                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8"><%= record.rolePermissionId ? record.rolePermissionId.name : '-' %></dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge <%= record.isActive ? 'badge-success' : 'badge-secondary' %>"><%= record.isActive ? 'Active' : 'Inactive' %></span>
                    </dd>

                    <dt class="col-sm-4">Last Login</dt>
                    <dd class="col-sm-8"><%= record.lastLoginAt ? new Date(record.lastLoginAt).toLocaleString() : 'Never' %></dd>

                    <dt class="col-sm-4">Created By</dt>
                    <dd class="col-sm-8"><%= record.createdBy ? (record.createdBy.firstName + ' ' + record.createdBy.lastName) : '-' %></dd>

                    <dt class="col-sm-4">Created At</dt>
                    <dd class="col-sm-8"><%= new Date(record.createdAt).toLocaleString() %></dd>
                </dl>
            </div>
        </div>
    </div>
</div>
