<div class="card">
    <div class="card-header">
        <h3 class="card-title">Roles &amp; Permissions</h3>
        <div class="card-tools">
            <% if (can('ROLE-PERMISSION.CREATE')) { %>
                <a href="/panel/roles/create" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Add Role</a>
            <% } %>
        </div>
    </div>

    <div class="card-body border-bottom">
        <form method="GET" action="/panel/roles" class="row align-items-end">
            <div class="col-md-4 mb-3">
                <label class="form-label mb-1">Search</label>
                <input type="text" name="search" value="<%= filters.search || '' %>" class="form-control" placeholder="Role name">
            </div>
            <div class="col-md-2 mb-3">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-vcenter table-striped mb-0 card-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Created At</th>
                        <th style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!records || !records.length) { %>
                        <tr><td colspan="4" class="text-center text-muted py-4">No roles found</td></tr>
                    <% } %>
                    <% records.forEach(function (r) { %>
                        <tr>
                            <td><%= r.name %></td>
                            <td><%= r.department %></td>
                            <td><%= new Date(r.createdAt).toLocaleDateString() %></td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <% if (can('ROLE-PERMISSION.UPDATE')) { %>
                                        <a href="/panel/roles/<%= r._id %>/edit" class="btn btn-xs btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                    <% } %>
                                    <% if (can('ROLE-PERMISSION.DELETE')) { %>
                                        <form action="/panel/roles/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this role?');">
                                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <%- include('../partials/pagination') %>
    </div>
</div>
