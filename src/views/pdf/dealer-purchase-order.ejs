<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Purchase Order <%= order.poNumber %></title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; color: #1f2937; font-size: 12px; margin: 0; }
        .row { display: flex; justify-content: space-between; align-items: flex-start; }
        .brand { font-size: 20px; font-weight: bold; color: #111827; }
        .brand img { max-height: 42px; }
        .title { text-align: right; }
        .title h1 { font-size: 20px; margin: 0; color: #1e293b; }
        .muted { color: #6b7280; }
        .label { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: #6b7280; margin-bottom: 4px; }
        hr { border: 0; border-top: 1px solid #e5e7eb; margin: 14px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th { background: #f3f4f6; font-size: 11px; text-align: left; padding: 8px; }
        td { padding: 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
        .num { text-align: right; white-space: nowrap; }
        .variant { font-size: 10px; color: #6b7280; }
        .totals { width: 45%; margin-left: auto; margin-top: 14px; }
        .totals td { border: 0; padding: 4px 8px; }
        .grand td { border-top: 1px solid #d1d5db; font-weight: bold; font-size: 14px; padding-top: 8px; }
        .box { margin-top: 18px; }
        .status { display: inline-block; padding: 2px 8px; border-radius: 10px; background: #f3f4f6; font-size: 10px; }
        .signatures { margin-top: 48px; }
        .sign { width: 40%; border-top: 1px solid #9ca3af; padding-top: 6px; font-size: 11px; color: #6b7280; }
    </style>
</head>
<body>
    <div class="row">
        <div class="brand">
            <% if (company.logoUrl) { %><img src="<%= company.logoUrl %>" alt="<%= company.name %>"><% } else { %><%= company.name %><% } %>
        </div>
        <div class="title">
            <h1>Purchase Order</h1>
            <div class="muted">#<%= order.poNumber %></div>
            <div class="status"><%= status.label %></div>
        </div>
    </div>

    <hr>

    <div class="row">
        <div>
            <div class="label">Prepared For</div>
            <strong><%= dealer.businessName %></strong><br>
            <% if (dealer.contactName) { %><%= dealer.contactName %><br><% } %>
            <% if (dealer.taxNumber) { %>GSTIN: <%= dealer.taxNumber %><br><% } %>
            <% if (dealer.dealerCode) { %>Dealer ID: <%= dealer.dealerCode %><% } %>
        </div>
        <div class="title">
            <div class="label">Details</div>
            Date: <%= formatDate(order.orderDate) %><br>
            <% if (company.email) { %><%= company.email %><br><% } %>
            <% if (company.phone) { %><%= company.phone %><% } %>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 24px">#</th>
                <th>Item Name</th>
                <th class="num">Qty</th>
                <th class="num">Rate</th>
                <th class="num">GST</th>
                <th class="num">Total</th>
            </tr>
        </thead>
        <tbody>
            <% (order.items || []).forEach(function (item, index) { %>
            <tr>
                <td><%= index + 1 %></td>
                <td>
                    <strong><%= item.productName %></strong>
                    <% if (item.variantLabel) { %><div class="variant"><%= item.variantLabel %></div><% } %>
                    <% if (item.sku) { %><div class="variant"><%= item.sku %></div><% } %>
                </td>
                <td class="num"><%= item.quantity %></td>
                <td class="num"><%= money(item.unitPrice) %></td>
                <td class="num"><%= money(item.tax) %></td>
                <td class="num"><strong><%= money(item.total) %></strong></td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <table class="totals">
        <tr><td class="muted">Subtotal:</td><td class="num"><%= money(order.subtotal) %></td></tr>
        <tr><td class="muted">GST:</td><td class="num"><%= money(order.tax) %></td></tr>
        <tr><td class="muted">Shipping &amp; Insurance:</td><td class="num"><%= order.shipping ? money(order.shipping) : 'Free' %></td></tr>
        <tr class="grand"><td>Grand Total:</td><td class="num"><%= money(order.totalAmount) %></td></tr>
    </table>

    <% if (order.shippingAddress) { %>
    <div class="box">
        <div class="label">Shipping Address</div>
        <%= order.shippingAddress %>
    </div>
    <% } %>

    <% if (order.remarks) { %>
    <div class="box">
        <div class="label">Special Instructions</div>
        <%= order.remarks %>
    </div>
    <% } %>

    <div class="row signatures">
        <div class="sign">Dealer Signature</div>
        <div class="sign" style="text-align: right">For <%= company.name %> - Authorized Signatory</div>
    </div>
</body>
</html>
