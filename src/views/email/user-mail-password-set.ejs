<tr style="box-sizing:border-box !important;">
    <td style="box-sizing:border-box !important;padding: 17px 0;">
        <table style="box-sizing:border-box !important;width: 100%;padding: 32px !important; background-color: #fff;">
            <tbody style="box-sizing:border-box !important;">
                <tr style="box-sizing:border-box !important;">
                    <td style="box-sizing:border-box !important;">
                        <p style="margin-top:0;margin-bottom: 16px;box-sizing:border-box !important;">
                            Dear <strong style="box-sizing:border-box !important;"><%= data.userId?.firstName %> <%= data.userId?.lastName %>,</strong>
                        </p>

                        <p style="margin-top:0;margin-bottom: 16px;box-sizing:border-box !important;">
                            Please click the below link provided to set your password for <%= config.appName %> account.
                        </p>

                        <a href="<%= passwordSetUrl %>" target="_blank" style="min-width:210px;text-align:center;display:inline-block;margin-top:10px;text-decoration:none;font-size:16px;font-weight:700;color:#fff;background:#5FA92C;border-radius:30px;padding:12px 30px;line-height:1.2;border:1px solid #5FA92C;">
                            Click here to set password
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </td>
</tr>